rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function canAccessRanking() {
      return signedIn() &&
        exists(/databases/$(database)/documents/rankingAccess/$(request.auth.uid));
    }

    function canPublishDirectly() {
      return canAccessRanking() || isAdmin();
    }

    function submission(submissionId) {
      return get(
        /databases/$(database)/documents/submissions/$(submissionId)
      );
    }

    function seasonIsActive(submissionId) {
      return get(
        /databases/$(database)/documents/seasons/$(submission(submissionId).data.seasonId)
      ).data.status == 'active';
    }

    match /users/{userId} {
      allow create: if signedIn() && request.auth.uid == userId;
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow update: if signedIn() && request.auth.uid == userId;
    }

    match /rankingAccess/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if isAdmin();
    }

    match /admins/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow write: if false;
    }

    match /seasons/{seasonId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /creators/{creatorId} {
      allow read: if true;
      allow create: if signedIn();
      allow update, delete: if isAdmin();
    }

    match /submissions/{submissionId} {
      allow read: if isAdmin() || (resource.data.status == 'approved' && canAccessRanking());

      allow create: if signedIn()
        && request.resource.data.submittedByUserId == request.auth.uid
        && (
          request.resource.data.status == 'pending' ||
          (request.resource.data.status == 'approved' && canPublishDirectly())
        )
        && request.resource.data.source == 'web'
        && request.resource.data.ratingTotal == 0
        && request.resource.data.ratingCount == 0
        && request.resource.data.likesCount == 0
        && request.resource.data.commentsCount == 0;

      allow update, delete: if isAdmin();

      match /ratings/{userId} {
        allow read: if canAccessRanking() || isAdmin();

        allow create: if signedIn()
          && request.auth.uid == userId
          && request.resource.data.score is int
           && request.resource.data.score >= 1
           && request.resource.data.score <= 10
           && submission(submissionId).data.status == 'approved'
           && seasonIsActive(submissionId);

        allow update: if signedIn()
          && request.auth.uid == userId
          && request.resource.data.score is int
          && request.resource.data.score >= 1
          && request.resource.data.score <= 10
           && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['score', 'updatedAt'])
           && seasonIsActive(submissionId);

        allow delete: if signedIn() && request.auth.uid == userId;
      }

      match /likes/{userId} {
        allow read: if canAccessRanking() || isAdmin();

        allow create, delete: if signedIn()
          && request.auth.uid == userId
          && submission(submissionId).data.status == 'approved'
          && seasonIsActive(submissionId);
      }

      match /comments/{commentId} {
        allow read: if isAdmin() || (resource.data.status == 'visible' && canAccessRanking());

        allow create: if signedIn()
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.body is string
          && request.resource.data.body.size() >= 1
          && request.resource.data.body.size() <= 1000
          && submission(submissionId).data.status == 'approved'
          && seasonIsActive(submissionId);

        allow update, delete: if isAdmin();
      }
    }
  }
}
